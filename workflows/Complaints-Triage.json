    {
      "parameters": {
        "jsCode": "const highRiskTerms = ['hardship','financial difficulty','afca','ombudsman',\n                       'legal','discrimination','unauthorised','fraud'];\n\nreturn $input.all().map(item => {\n  const key = Object.keys(item.json)\n    .find(k => k.toLowerCase().replace(/[^a-z]/g, '').includes('complaint'));\n\n  if (!key) {\n    throw new Error('Validation failed — no complaint text field found. Keys received: '\n                    + Object.keys(item.json).join(', '));\n  }\n\n  const text = String(item.json[key] ?? '').toLowerCase();\n  const matched = highRiskTerms.filter(t => text.includes(t));\n\n  return { json: {\n    ...item.json,\n    severity: matched.length ? 'High' : 'Standard',\n    matched_terms: matched.join(', ') || 'none',\n    triaged_at: new Date().toISOString()\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
